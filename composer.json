{
    "name": "zofe/handbook-module",
    "description": "A knowledge base for rapyd-admin in the spirit of Outline: collections, nested markdown documents, live preview, search and revision history",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Felice Ostuni",
            "email": "felice.ostuni@gmail.com",
            "homepage": "https://rapyd.dev"
        }
    ],
    "keywords": [
        "laravel",
        "livewire",
        "rapyd-admin",
        "handbook",
        "markdown",
        "knowledge base"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/config": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "league/commonmark": "^2.6",
        "zofe/rapyd-admin": "^9.17"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Handbook\\": "./"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Modules\\Handbook\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "App\\Modules\\Handbook\\HandbookServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
